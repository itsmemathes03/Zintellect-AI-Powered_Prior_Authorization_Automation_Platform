# Backend environment variables
# JWT secret for token signing (generate with python -c "import secrets;print(secrets.token_urlsafe(64))")
SECRET_KEY=your_jwt_secret_here

# Email configuration for notifications (optional – app works without it)
EMAIL_ADDRESS=you@example.com
EMAIL_PASSWORD=your_email_password_here

# Gmail SMTP configuration (falls back to EMAIL_ADDRESS/EMAIL_PASSWORD if not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_APP_PASSWORD=your_app_password_here
SMTP_FROM_NAME=Zintellect
SMTP_FROM_EMAIL=you@example.com

# ChromaDB vector store path
CHROMA_DB_PATH=app/vector_db/chroma

# Ollama LLM model for medical entity extraction (pulled via: ollama pull <model>)
OLLAMA_MODEL=qwen2.5:1.5b-instruct

# Ollama LLM model for CareBridge AI chatbot
CHATBOT_MODEL=qwen2.5:7b-instruct

# Ollama server URL (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Ollama inference timeout in seconds (default: 300)
OLLAMA_TIMEOUT=300

# Frontend URL for CORS (comma-separated, no spaces)
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# App environment (development/production)
APP_ENV=development

# Google Gemini configuration (optional)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.6-flash

# n8n Workflow Automation
N8N_WEBHOOK_URL=https://your_n8n_webhook_url_here
N8N_ERROR_WEBHOOK_URL=http://localhost:5678/webhook/zintellect-backend-errors
N8N_WEBHOOK_SECRET=your_webhook_secret_here
N8N_TIMEOUT_SECONDS=5

# n8n webhook authentication — set the same value in n8n as ZINTELLECT_WEBHOOK_SECRET
# Used by: N8N_WEBHOOK_SECRET (sent as X-Webhook-Secret header)
